# Variables d'environnement pour l'hébergement Cloud (Option 1 : Railway, Render, Fly.io)
# Option A : URL complète (fournie automatiquement par Railway sous MYSQL_URL)
# FINCAISSE_DB_URL=mysql://utilisateur:motdepasse@hote:3306/fincaisse

# Option B : Paramètres séparés
FINCAISSE_DB_HOST=127.0.0.1
FINCAISSE_DB_PORT=3306
FINCAISSE_DB_NAME=fincaisse
FINCAISSE_DB_USER=root
FINCAISSE_DB_PASS=
# FINCAISSE_DB_SSL_CA=/etc/ssl/certs/ca-certificates.crt
